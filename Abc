// ==========================================
// MAX-CONTROL ULTIMATE SCRIPT (XBOX SERIES X)
// ==========================================
// Menu Modifiers (Hold Left Bumper / LB):
// - LB + VIEW     : Toggle Rapid Fire
// - LB + MENU     : Toggle Anti-Recoil (Zero Rise)
// - LB + A        : Toggle Drop-Shot
// - LB + B        : Toggle Auto-Sprint
// ==========================================

int rapid_fire    = TRUE;   // Default ON for maximum auto fire
int anti_recoil   = TRUE;   // Default ON to lock crosshairs
int drop_shot     = FALSE;
int auto_sprint   = TRUE;   // Default ON for fluid movement

// Maximum Tuning Parameters (Adjust higher if heavy guns still pull up)
int recoil_strength = 58;   // Aggressive downward pull to completely stop vertical climb
int fire_delay      = 22;   // Ultra-fast milliseconds delay between rapid shots

main {
    // --- MENU TOGGLE COMBOS (Hold LB / L1) ---
    if (get_val(XB1_LB)) {
        if (event_press(XB1_VIEW)) {
            rapid_fire = !rapid_fire;
        }
        if (event_press(XB1_MENU)) {
            anti_recoil = !anti_recoil;
        }
        if (event_press(XB1_A)) {
            drop_shot = !drop_shot;
        }
        if (event_press(XB1_B)) {
            auto_sprint = !auto_sprint;
        }
    }

    // --- MAXIMUM RAPID FIRE MODULE ---
    if (rapid_fire && get_val(XB1_RT)) {
        combo_run(RapidFire_Fast);
    }

    // --- ZERO-RISE ANTI-RECOIL MODULE ---
    if (anti_recoil && get_val(XB1_RT)) {
        // Automatically applies heavy downward compensation only when firing
        set_val(XB1_RY, get_val(XB1_RY) + recoil_strength);
    }

    // --- DROP SHOT MODULE ---
    if (drop_shot && event_press(XB1_RT)) {
        combo_run(DropShot_Seq);
    }

    // --- AUTO SPRINT MODULE ---
    if (auto_sprint && get_val(XB1_LY) < -80) {
        set_val(XB1_LS, 100);
    }
}

// Ultra-Fast Rapid Fire Loop
combo RapidFire_Fast {
    set_val(XB1_RT, 100);
    wait(fire_delay);
    set_val(XB1_RT, 0);
    wait(fire_delay);
}

// Drop Shot Loop
combo DropShot_Seq {
    set_val(XB1_B, 100);
    wait(50);
    set_val(XB1_B, 0);
    wait(200);
}
