// ==========================================
// ULTIMATE TITAN ONE ADVANCED SCRIPT (XBOX SERIES X)
// ==========================================
// Menu Modifiers (Hold Left Bumper / LB to access):
// - LB + VIEW     : Toggle Rapid Fire
// - LB + MENU     : Toggle Anti-Recoil
// - LB + A        : Toggle Drop-Shot
// - LB + B        : Toggle Auto-Sprint
// ==========================================

int rapid_fire    = FALSE;
int anti_recoil   = FALSE;
int drop_shot     = FALSE;
int auto_sprint   = FALSE;

// Custom Tuning Values
int recoil_strength = 32; // Adjust vertical compensation strength (1-100)
int fire_delay      = 30; // Milliseconds between rapid shots

main {
    // --- MENU TOGGLE COMBOS (Hold LB / L1) ---
    if (get_val(XB1_LB)) {
        if (event_press(XB1_VIEW)) {
            rapid_fire = !rapid_fire;
        }
        if (event_press(XB1_MENU)) {
            anti_recoil = !anti_recoil;
        }
        if (event_press(XB1_A)) {
            drop_shot = !drop_shot;
        }
        if (event_press(XB1_B)) {
            auto_sprint = !auto_sprint;
        }
    }

    // --- RAPID FIRE MODULE ---
    if (rapid_fire && get_val(XB1_RT)) {
        combo_run(RapidFire_Seq);
    }

    // --- ANTI-RECOIL MODULE ---
    if (anti_recoil && get_val(XB1_RT)) {
        set_val(XB1_RY, get_val(XB1_RY) + recoil_strength);
    }

    // --- DROP SHOT MODULE ---
    if (drop_shot && event_press(XB1_RT)) {
        combo_run(DropShot_Seq);
    }

    // --- AUTO SPRINT MODULE ---
    if (auto_sprint && get_val(XB1_LY) < -80) {
        set_val(XB1_LS, 100);
    }
}

// Rapid Fire Loop
combo RapidFire_Seq {
    set_val(XB1_RT, 100);
    wait(fire_delay);
    set_val(XB1_RT, 0);
    wait(fire_delay);
}

// Drop Shot Loop
combo DropShot_Seq {
    set_val(XB1_B, 100);
    wait(60);
    set_val(XB1_B, 0);
    wait(250);
}
